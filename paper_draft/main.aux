\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Standard detectors are sensitive in one domain}{5}{subsection.4.1}\protected@file@percent }
\newlabel{sec:standard}{{4.1}{5}{Standard detectors are sensitive in one domain}{subsection.4.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Detection rate of the five standard detectors on known-misaligned anchors, by domain. Bars show TPR with Wilson 95\% intervals; diamonds show FPR on the aligned controls; dashed lines mark the hypothesized 70\% and 30\% thresholds. The harm classifier and the harm-rubric judge detect overt anchors and almost no subtle ones. Refusal matching flags everything in the subtle domains and the toxicity classifier flags nothing anywhere.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:standard}{{2}{6}{Detection rate of the five standard detectors on known-misaligned anchors, by domain. Bars show TPR with Wilson 95\% intervals; diamonds show FPR on the aligned controls; dashed lines mark the hypothesized 70\% and 30\% thresholds. The harm classifier and the harm-rubric judge detect overt anchors and almost no subtle ones. Refusal matching flags everything in the subtle domains and the toxicity classifier flags nothing anywhere}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Pre-specified tests. Significant $p$-values are Holm-corrected; the two non-significant values shown (0.13 and 0.52) are uncorrected and both become 1.0 after correction. H1--H3 are exact one-sided binomial tests against the 70\% and 30\% thresholds; the last column is a Fisher exact test of overt vs.\ each subtle TPR. \text  {$\mathsurround \z@ \mathchar "458$}\ = supported, $\times $ = not supported. The hypothesis is fully supported only for \textsc  {Granite Guardian}\xspace  .}}{6}{table.4}\protected@file@percent }
\newlabel{tab:tests}{{4}{6}{Pre-specified tests. Significant $p$-values are Holm-corrected; the two non-significant values shown (0.13 and 0.52) are uncorrected and both become 1.0 after correction. H1--H3 are exact one-sided binomial tests against the 70\% and 30\% thresholds; the last column is a Fisher exact test of overt vs.\ each subtle TPR. \checkmark \ = supported, $\times $ = not supported. The hypothesis is fully supported only for \granite }{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Rubric ablation with the primary judge (\textsc  {Llama-3.1-8B}\xspace  ) on the two subtle domains. Each cell reports TPR / FPR / AUROC. Naming the behaviour is enough for sycophancy; for reasoning, the judge discriminates only with the reference answer, and even then its default threshold flags half of the correct solutions. Best AUROC per domain in {\bf  bold}.}}{7}{table.5}\protected@file@percent }
\newlabel{tab:rubric}{{5}{7}{Rubric ablation with the primary judge (\llama ) on the two subtle domains. Each cell reports TPR / FPR / AUROC. Naming the behaviour is enough for sycophancy; for reasoning, the judge discriminates only with the reference answer, and even then its default threshold flags half of the correct solutions. Best AUROC per domain in {\bf bold}}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Rubric ablation on the two subtle domains for both judges. Coloured bars show TPR on anchors and grey bars show FPR on matched controls, with Wilson 95\% intervals. Top row (\textsc  {Llama-3.1-8B}\xspace  ): a targeted rubric separates sycophancy anchors from controls, but on reasoning it raises both bars. Bottom row (\textsc  {Qwen2.5-7B}\xspace  ): on the planned rubrics the grey bars are as high as or higher than the coloured ones, i.e.,\xspace  the judge does not discriminate or is inverted.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:ablation}{{3}{7}{Rubric ablation on the two subtle domains for both judges. Coloured bars show TPR on anchors and grey bars show FPR on matched controls, with Wilson 95\% intervals. Top row (\llama ): a targeted rubric separates sycophancy anchors from controls, but on reasoning it raises both bars. Bottom row (\qwen ): on the planned rubrics the grey bars are as high as or higher than the coloured ones, \ie the judge does not discriminate or is inverted}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Rubric ablation: two different kinds of gap}{7}{subsection.4.2}\protected@file@percent }
\newlabel{sec:ablation}{{4.2}{7}{Rubric ablation: two different kinds of gap}{subsection.4.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Second judge (\textsc  {Qwen2.5-7B}\xspace  ) and the post-hoc rubric variant with self-describing answer words (suffix ``2''). Each cell reports TPR / FPR / AUROC. On the planned yes/no rubrics \textsc  {Qwen2.5-7B}\xspace  scores below chance. The post-hoc wording repairs its reasoning verdicts but not its sycophancy verdicts. Post-hoc rows are exploratory. \textsc  {Qwen2.5-7B}\xspace  also generated the subtle anchors and controls, so it judges its own text.}}{8}{table.6}\protected@file@percent }
\newlabel{tab:second}{{6}{8}{Second judge (\qwen ) and the post-hoc rubric variant with self-describing answer words (suffix ``2''). Each cell reports TPR / FPR / AUROC. On the planned yes/no rubrics \qwen scores below chance. The post-hoc wording repairs its reasoning verdicts but not its sycophancy verdicts. Post-hoc rows are exploratory. \qwen also generated the subtle anchors and controls, so it judges its own text}{table.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}A second judge does not reproduce the targeted-rubric results}{8}{subsection.4.3}\protected@file@percent }
\newlabel{sec:second_judge}{{4.3}{8}{A second judge does not reproduce the targeted-rubric results}{subsection.4.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Score distributions}{8}{subsection.4.4}\protected@file@percent }
\newlabel{sec:scores}{{4.4}{8}{Score distributions}{subsection.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Score distributions for three standard detectors (rows) in the three domains (columns); the dashed line is the 0.5 threshold. In the overt domain, anchors (outlined) and controls (grey) separate. In the sycophancy domain, harm-detector scores for both groups pile up at zero, so no threshold recovers the anchors. \textsc  {Granite Guardian}\xspace  's scores on flawed-reasoning anchors shift upward but mostly stay below 0.5.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:scores}{{4}{9}{Score distributions for three standard detectors (rows) in the three domains (columns); the dashed line is the 0.5 threshold. In the overt domain, anchors (outlined) and controls (grey) separate. In the sycophancy domain, harm-detector scores for both groups pile up at zero, so no threshold recovers the anchors. \granite 's scores on flawed-reasoning anchors shift upward but mostly stay below 0.5}{figure.4}{}}
