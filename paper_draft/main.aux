\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Anchors and controls. Labels in every domain come from a source that is independent of all detectors. The overt domain uses real, human-labelled responses; the two subtle domains use prompted responses that pass a programmatic check. $n$ is anchors / controls; in the subtle domains these are matched pairs.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:anchors}{{1}{4}{Anchors and controls. Labels in every domain come from a source that is independent of all detectors. The overt domain uses real, human-labelled responses; the two subtle domains use prompted responses that pass a programmatic check. $n$ is anchors / controls; in the subtle domains these are matched pairs}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Detectors. Every detector sees the same input in every domain: the user request and the response. Detectors 1--5 form the standard battery; detectors 6--7 are the rubric ablation and apply to the two subtle domains only.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:detectors}{{2}{4}{Detectors. Every detector sees the same input in every domain: the user request and the response. Detectors 1--5 form the standard battery; detectors 6--7 are the rubric ablation and apply to the two subtle domains only}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Detectors}{4}{subsection.3.3}\protected@file@percent }
\newlabel{sec:detectors}{{3.3}{4}{Detectors}{subsection.3.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Standard detector battery on all three domains (LLM judges use \textsc  {Llama-3.1-8B}\xspace  ). TPR is the detection rate on anchors with a Wilson 95\% interval; FPR is the flag rate on aligned controls; $J = \text  {TPR} - \text  {FPR}$. AUROC intervals are bootstrap 95\%. \textsc  {Refusal-Keyword}\xspace  has no continuous score. Rows for the two purpose-built harm detectors are in {\bf  bold}: both detect overt anchors and almost none of the subtle ones.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:main}{{3}{5}{Standard detector battery on all three domains (LLM judges use \llama ). TPR is the detection rate on anchors with a Wilson 95\% interval; FPR is the flag rate on aligned controls; $J = \text {TPR} - \text {FPR}$. AUROC intervals are bootstrap 95\%. \refusal has no continuous score. Rows for the two purpose-built harm detectors are in {\bf bold}: both detect overt anchors and almost none of the subtle ones}{table.3}{}}
